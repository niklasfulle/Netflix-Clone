# Optional host file: /root/netflix-secrets/video-analysis.env (root-owned, 0600).
# Enable only after the external vision endpoint is configured and reachable.
VIDEO_ANALYSIS_ENABLED=false
VIDEO_ANALYSIS_URL=https://models.example.invalid/v1
VIDEO_ANALYSIS_MODEL=vision-model
# Stable identifier including the deployed model/quantization revision.
VIDEO_ANALYSIS_MODEL_ID=vision-model-revision-1
VIDEO_ANALYSIS_API_KEY=
# Absolute path on the same origin; /health for llama.cpp, /v1/models for a
# service exposing the standard authenticated model-list endpoint.
VIDEO_ANALYSIS_HEALTH_PATH=/v1/models
VIDEO_ANALYSIS_RESPONSE_FORMAT=json_schema
VIDEO_ANALYSIS_TIMEOUT_MS=90000
VIDEO_ANALYSIS_HEALTH_TIMEOUT_MS=1500
# Optional domain-specific instructions belong only in this host file.
VIDEO_ANALYSIS_DOMAIN_INSTRUCTIONS=
VIDEO_ANALYSIS_NEGATIVE_LABEL=
