[Unit]
Description=Netflix Clone catalog transfer and application restart controller
After=docker.service
Requires=docker.service

[Service]
Type=simple
Environment=CATALOG_TRANSFER_ENVIRONMENT={{ deployment_environment }}
Environment=CATALOG_TRANSFER_STORAGE=/var/lib/netflix-catalog-transfers
Environment=CATALOG_TRANSFER_MOUNT=/var/lib/netflix-catalog-transfers
Environment=CATALOG_TRANSFER_COMPOSE_FILE={{ docker_compose_path }}/docker-compose.yml
ExecStart=/usr/bin/python3 /usr/local/lib/netflix-deploy/catalog-transfer-host.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/netflix-catalog-transfers

[Install]
WantedBy=multi-user.target
