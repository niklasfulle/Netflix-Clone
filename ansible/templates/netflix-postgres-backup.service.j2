[Unit]
Description=Create and restore-verify a scheduled Netflix Clone PostgreSQL backup
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/root/netflix-secrets/app.env
Environment=POSTGRES_BACKUP_IMAGE={{ postgres_backup_image }}
Environment=POSTGRES_BACKUP_LOCK_WAIT_SECONDS={{ postgres_backup_lock_wait_seconds }}
Environment=POSTGRES_BACKUP_TIMEOUT_SECONDS={{ postgres_backup_timeout_seconds }}
Environment=POSTGRES_BACKUP_MINIMUM_COPIES={{ postgres_backup_minimum_copies }}
Environment=POSTGRES_BACKUP_RETENTION_DAILY_DAYS={{ postgres_backup_retention_daily_days }}
Environment=POSTGRES_BACKUP_RETENTION_WEEKLY_WEEKS={{ postgres_backup_retention_weekly_weeks }}
Environment=POSTGRES_BACKUP_RETENTION_MONTHLY_MONTHS={{ postgres_backup_retention_monthly_months }}
ExecStart=/usr/local/lib/netflix-deploy/run-postgres-backup.sh
TimeoutStartSec={{ postgres_backup_service_timeout_seconds }}s
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/root/netflix-secrets/app.env /usr/local/lib/netflix-deploy
ReadWritePaths=/root/netflix-database-backups /var/lib/netflix-backup-status /run/lock
