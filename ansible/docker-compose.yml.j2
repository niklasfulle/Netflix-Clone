services:
  app:
    image: {{ docker_registry }}/{{ image_name }}:{{ app_version }}
    container_name: netflix-clone
    env_file:
      - /root/netflix-secrets/app.env
      - /root/netflix-secrets/redis-app.env
    environment:
      DEPLOYMENT_ENVIRONMENT: {{ deployment_environment | quote }}
      DEPLOYMENT_STATUS_APPROVED_PEERS: {{ ('production' if deployment_environment == 'staging' else 'staging') | quote }}
      AUTH_URL: {{ canonical_url | quote }}
      NEXTAUTH_URL: {{ canonical_url | quote }}
      AUTH_PUBLIC_URL: {{ canonical_url | quote }}
      AUTH_TRUST_HOST: 'true'
      AUTH_TRUSTED_PROXY_HOPS: '1'
      AUTH_WEBAUTHN_RP_ID: {{ https_hostname | quote }}
      AUTH_WEBAUTHN_ORIGIN: {{ canonical_url | quote }}
      PUBLIC_CA_OVERLAP_DAYS: {{ public_ca_overlap_days | quote }}
    labels:
      com.netflix-clone.environment: {{ deployment_environment | quote }}
    ports:
      - "127.0.0.1:3000:3000"
    networks:
      - frontend
      - backend
    user: "10001:10001"
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    pids_limit: 200
    cpus: {{ container_cpu_limit }}
    mem_limit: 1g
    tmpfs:
      - /tmp:size=128m,mode=1777
      - /netflix-clone/.next/cache:size=256m,uid=10001,gid=10001
    volumes:
      - /movies:/movies
      - /series:/series
      - /var/lib/netflix-monitor:/monitor:ro
      - /var/lib/netflix-deployment-status:/deployment-status:ro
      - /var/lib/netflix-public-certificates:/public-certificates:ro
      - /var/lib/netflix-backup-status:/backup-status
      - /var/lib/netflix-logs:/netflix-clone/logs
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    restart: unless-stopped

  redis-runtime:
    image: {{ redis_image }}
    container_name: netflix-redis-runtime
    command:
      - redis-server
      - /usr/local/etc/redis/redis.conf
    env_file:
      - /root/netflix-secrets/redis-health.env
    labels:
      com.netflix-clone.environment: {{ deployment_environment | quote }}
      com.netflix-clone.role: redis-runtime
    networks:
      - backend
    user: "999:1000"
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    pids_limit: 100
    cpus: 0.50
    mem_limit: 256m
    tmpfs:
      - /data:size=32m,mode=0700,uid=999,gid=1000
      - /tmp:size=16m,mode=1777
    volumes:
      - {{ redis_config_path }}:/usr/local/etc/redis/redis.conf:ro
      - /root/netflix-secrets/redis-users.acl:/usr/local/etc/redis/users.acl:ro
    healthcheck:
      test: ["CMD-SHELL", "redis-cli --user health --no-auth-warning ping | grep -qx PONG"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 5s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    restart: unless-stopped

  proxy:
    image: {{ caddy_image }}
    container_name: netflix-proxy
    depends_on:
      - app
    networks:
      - frontend
    labels:
      com.netflix-clone.environment: {{ deployment_environment | quote }}
    ports:
      - "80:80"
      - "443:443"
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    pids_limit: 100
    cpus: 0.50
    mem_limit: 256m
    tmpfs:
      - /tmp:size=32m,mode=1777
    volumes:
      - {{ docker_compose_path }}/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    restart: unless-stopped

networks:
  frontend:
  backend:
    internal: true

volumes:
  caddy_data:
  caddy_config:
