# Copy this file to .env.e2e.local and fill in dedicated local test-account
# credentials. Both accounts need a confirmed email, disabled 2FA, and at least
# one selectable profile. Never use production accounts or commit this file.
E2E_USER_EMAIL="..."
E2E_USER_PASSWORD="..."
E2E_ADMIN_EMAIL="..."
E2E_ADMIN_PASSWORD="..."

# Required for MFA/passkey journeys that clean up test-only database state.
# The database name must contain "stage" or "staging" and must match the
# staging application reached through PLAYWRIGHT_BASE_URL.
E2E_DATABASE_URL="postgresql://E2E_USER:E2E_PASSWORD@DB_HOST:5432/Netflix_staging"

# Optional feature-flagged local passkey coverage. WebAuthn permits HTTP only
# for localhost, so PLAYWRIGHT_BASE_URL must use the same host when enabled.
# AUTH_PASSKEYS_ENABLED="true"
# AUTH_WEBAUTHN_RP_ID="localhost"
# AUTH_WEBAUTHN_RP_NAME="Netflix Clone E2E"
# AUTH_WEBAUTHN_ORIGIN="http://localhost:3000"

# Optional when the application is already running elsewhere.
# PLAYWRIGHT_BASE_URL="http://192.168.1.164:3000"
# PLAYWRIGHT_EXTERNAL_SERVER="true"
